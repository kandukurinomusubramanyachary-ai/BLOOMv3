{
  "cli": {
    "version": ">=16.23.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "sdk-57"
      },
      "env": {
        "EXPO_PUBLIC_BLOOM_DEV_AUTH": "0",
        "EXPO_PUBLIC_BLOOM_STRENGTH": "1",
        "EXPO_PUBLIC_BLOOM_NATIVE_TRACKING": "0"
      },
      "ios": {
        "image": "sdk-57"
      }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle",
        "image": "sdk-57"
      },
      "ios": {
        "simulator": false,
        "image": "sdk-57"
      },
      "env": {
        "EXPO_PUBLIC_BLOOM_DEV_AUTH": "0",
        "EXPO_PUBLIC_BLOOM_STRENGTH": "1",
        "EXPO_PUBLIC_BLOOM_NATIVE_TRACKING": "0"
      }
    },
    "native-qa": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_BLOOM_NATIVE_TRACKING": "1"
      }
    }
  }
}
