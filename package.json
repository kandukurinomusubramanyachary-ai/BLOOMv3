{
  "name": "bloom",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "build:web": "expo export --platform web",
    "build:web:release": "npm run release:config:check && npm run build:web",
    "typecheck": "tsc --noEmit",
    "check:release-config": "node scripts/check-release-config.cjs",
    "release:config:check": "node scripts/check-release-config.cjs",
    "test": "node server/all.test.js",
    "test:backend": "node server/megV2Bridge.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bloom-auth \"node server/firestore.rules.test.js\"",
    "generate:brand-assets": "node scripts/generate-logo-assets.js",
    "check:native-config": "node scripts/check-native-config.cjs",
    "eas-build-post-install": "node scripts/check-eas-build.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/stack": "^7.0.0",
    "@types/react": "~19.2.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-screen-capture": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "express": "^4.22.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "babel-preset-expo": "~57.0.12",
    "firebase-tools": "^15.24.0",
    "playwright": "^1.63.0",
    "pngjs": "3.4.0",
    "react-test-renderer": "19.2.3"
  },
  "private": true,
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
